{
  "name": "rove-showcase",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/prepare-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --config vitest.config.ts && node --test scripts/wasm-memory-limit.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mlc-ai/web-llm": "^0.2.84",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.0"
  }
}
