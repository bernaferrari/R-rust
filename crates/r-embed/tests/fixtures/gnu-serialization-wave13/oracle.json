{
  "source": "GNU R serialize.c persistence-hook dispatch",
  "cases": [
    {
      "name": "serialize_invokes_refhook_for_environment",
      "code": "local({e<-new.env();hits<-0L;raw<-serialize(e,NULL,refhook=function(x){hits<<-hits+1L;\"x\"});identical(hits,1L)&&is.raw(raw)})",
      "expected": true
    },
    {
      "name": "serialize_explicit_null_roundtrips_and_missing_arguments_still_error",
      "code": "local({ok<-identical(unserialize(serialize(NULL,NULL)),NULL);mo<-tryCatch(serialize(connection=NULL),error=function(e)grepl('object',conditionMessage(e),fixed=TRUE));mc<-tryCatch(serialize(object=NULL),error=function(e)grepl('connection',conditionMessage(e),fixed=TRUE));ok&&mo&&mc})",
      "expected": true
    }
  ]
}
