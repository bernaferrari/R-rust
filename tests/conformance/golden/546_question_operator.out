prefix: `?`(x)
binary: `?`(x, y)
double-prefix: `?`(`?`(x))
prefix-binary: `?`(`?`(a), b)
left-assoc: `?`(`?`(a, b), c)
rhs-prec: `?`(a, b + c)
lhs-prec: `?`(1 + 2, foo)
unary-lhs: `?`(-1, x)
prefix-after-op: `?`(TRUE)
nl-after-op: `?`(1, 2)
rhs-prefix: `?`(a, `?`(b))
in-call: f(`?`(x))
prefix-fn: `?`(function(x) x)
err-? unexpected-end-of-input: TRUE
err-1? unexpected-end-of-input: TRUE
err-x? unexpected-end-of-input: TRUE
